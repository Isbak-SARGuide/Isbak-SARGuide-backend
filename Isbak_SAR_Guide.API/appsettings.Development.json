{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=isbak_sar_guide;Username=postgres;Password=postgres"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },

  "Jwt": {
    "_comment": "SADECE yerel gelistirme icin. Production'da SecretKey Jwt__SecretKey ortam degiskeninden gelmeli, buradaki deger asla kullanilmamali.",
    "Issuer": "Isbak_SAR_GuideApi",
    "Audience": "Isbak_SAR_GuideAdmin",
    "SecretKey": "yerel-gelistirme-icin-en-az-32-karakter-uzunlugunda-gizli-anahtar",
    "ExpiryMinutes": 60
  },

  "Storage": {
    "_comment": "BasePath, API projesinin (Isbak_SAR_Guide.API/) content root'una gore - repo kokundeki storage/ klasorune boyle cikilir (cd Isbak_SAR_Guide.API && dotnet run varsayimiyla).",
    "BasePath": "../storage",
    "MaxFileSizeBytes": 20971520,
    "OrphanGraceHours": 24
  },

  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  }

}
