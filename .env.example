# compose.prod.yaml icin ornek ortam degiskenleri.
# "cp .env.example .env" ile kopyala, gercek degerleri doldur.
# .env repo'ya GIRMEZ (bkz. .gitignore) - gercek sirlar burada commitlenmez.

POSTGRES_DB=isbak_sar_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

JWT_ISSUER=Isbak_SAR_GuideApi
JWT_AUDIENCE=Isbak_SAR_GuideAdmin
JWT_SECRET_KEY=
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=14

CORS_ALLOWED_ORIGIN_0=

STORAGE_MAX_FILE_SIZE_BYTES=20971520
STORAGE_ORPHAN_GRACE_HOURS=24

LOGIN_RATE_LIMIT_PERMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
